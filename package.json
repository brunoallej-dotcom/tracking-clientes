{
  "name": "tracking-clientes",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:security": "vitest run --config vitest.security.config.ts",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --fail-on error",
    "db:types": "node scripts/db-types.mjs",
    "contract:lint": "redocly lint contracts/openapi.v1.yaml",
    "build": "next build",
    "verify": "npm run lint && npm run typecheck && npm test && npm run test:integration && npm run test:security && npm run db:lint && npm run db:test && npm run db:types && npm run contract:lint && npm run build",
    "check:security": "node scripts/check-security.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "next": "16.4.6",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@redocly/cli": "2.78.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.10.1",
    "supabase": "3.1.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "type": "module",
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  }
}
