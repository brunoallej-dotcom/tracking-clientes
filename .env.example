# -----------------------------------------------------------------------------
# tracking-clientes — variáveis de ambiente (SOMENTE PLACEHOLDERS)
# Copie para .env.local e preencha. Nunca commite .env.local.
# Em staging/produção, configure na Vercel (por ambiente; Preview → staging).
#
# Todas as variáveis são server-only: o navegador nunca fala direto com o
# Supabase (ADR-0002). Não use o prefixo NEXT_PUBLIC_ para nada daqui.
# -----------------------------------------------------------------------------

# --- Aplicação ---------------------------------------------------------------
# Origem permitida nas mutações (checagem de Origin/CSRF no proxy.ts).
APP_URL=http://localhost:3000
# debug | info | warn | error
LOG_LEVEL=info

# --- Supabase ----------------------------------------------------------------
# Local: valores exibidos por `npx supabase status` depois de `npx supabase start`.
# Remoto: Project Settings › API Keys (use as chaves novas publishable/secret).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
# Ignora a RLS. Usada só por src/shared/infrastructure/supabase/admin-client.ts.
SUPABASE_SECRET_KEY=

# --- Rate limiting (ADR-0004) ------------------------------------------------
# Pepper do HMAC das chaves de rate limit (IP/e-mail nunca são gravados em claro).
# Gere com: openssl rand -base64 32
RATE_LIMIT_PEPPER=
